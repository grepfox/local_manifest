#!/bin/bash

# Define colors
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
NC='\033[0m' # No Color

function banner() {
    echo -e "${BLUE}"
    echo "█████████████████████████████████████████████████████████████████████"
    echo "█                                                                   █"
    printf "█  %-65s █\n" "$1"
    echo "█                                                                   █"
    echo "█████████████████████████████████████████████████████████████████████"
    echo -e "${NC}"
}

banner "STARTING LINEAGE BUILD SCRIPT"

echo -e "${YELLOW}REMOVING OLD LOCAL MANIFESTS${NC}"
rm -rf .repo/local_manifests
rm -rf lexus-files

echo -e "${YELLOW}NUKING OLD STUFF${NC}"

echo -e "${YELLOW}INITIALIZING REPO WITH LINEAGE MANIFEST${NC}"
repo init https://github.com/LineageOS/android.git -b lineage-23.1 --git-lfs --depth=1

git clone https://github.com/Oneplus-Nord5-development/local_manifests .repo/local_manifests -b 23.1

echo -e "${YELLOW}REMOVING OLD PREBUILTS AND HARDWARE REPOS${NC}"
rm -rf prebuilts/clang/host/linux-x86
rm -rf hardware/oplus
rm -rf packages/modules/Connectivity
rm -rf vendor/oplus device/oplus

echo -e "${YELLOW}SYNCING SOURCE CODE${NC}"
if [ -f /opt/crave/resync.sh ]; then
    /opt/crave/resync.sh
else
repo sync -c --no-clone-bundle --no-tags --optimized-fetch --prune --force-sync -j8
fi

rm -rf android_hardware_oplus
rm -rf hardware/oplus
git clone https://github.com/LineageOS/android_hardware_oplus hardware/oplus -b lineage-23.1

#rm -rf frameworks/base
#git clone https://github.com/Oneplus-Nord5-development/android_frameworks_base frameworks/base -b lineage-23.0 --depth=1
#rm -rf packages/apps/Launcher3
#git clone https://github.com/Oneplus-Nord5-development/android_packages_apps_Launcher3 packages/apps/Launcher3 --depth=1
rm -rf vendor/oneplus/sm8650-common
git clone https://github.com/TheMuppets/proprietary_vendor_oneplus_sm8650-common vendor/oneplus/sm8650-common -b lineage-23.0 --depth=1

echo -e "${YELLOW}SOURCING BUILD ENVIRONMENT${NC}"
source build/envsetup.sh

# user and host
export BUILD_USERNAME=grepfox
export BUILD_HOSTNAME=home


# frameworks/base
repopickchain 463871 # VolumeDialog: Add support for left gravity

# packages/apps/Launcher3
repopickchain 465101 # Launcher3: Add resource to enable fixed landscape mode by default

# packages/apps/Settings
repopickchain 463786 # Settings: Promote external doze settings to first class

echo -e "${YELLOW}SETTING BUILD TARGET AND OPTIONS${NC}"
breakfast lexus
export TZ=Asia/Kolkata
export SKIP_ABI_CHECKS=true
export WITH_ADB_INSECURE=true
m installclean
brunch lexus

echo -e "${YELLOW}COLLECTING BUILD OUTPUT FILES${NC}"
rm -rf lexus-files
mkdir -p lexus-files
cp -r out/target/product/lexus/lineage-23.0* lexus-files/ 2>/dev/null
cp -r out/target/product/lexus/{recovery.img,boot.img,dtbo.img,init_boot.img,super_empty.img,vendor_boot.img} lexus-files/ 2>/dev/null

echo -e "${YELLOW}CLEANING UP REPOS AFTER BUILD${NC}"
rm -rf prebuilts/clang/host/linux-x86

echo -e "${YELLOW}BUILD COMPLETE - CHECKING FOR ERRORS${NC}"
if [ -f out/error.log ]; then
    cat out/error.log
else
    echo -e "${GREEN}NO ERROR LOG FOUND - BUILD COMPLETED SUCCESSFULLY${NC}"
fi

echo -e "${YELLOW}OUTPUT DIRECTORY CONTENTS${NC}"
ls -lh out/target/product/lexus
rm -rf vendor/lineage-priv/keys
banner "LINEAGE BUILD DONE"
