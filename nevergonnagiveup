#!/bin/bash

# Define colors
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
NC='\033[0m' # No Color

function banner() {
    echo -e "${BLUE}"
    echo "█████████████████████████████████████████████████████████████████████"
    echo "█                                                                   █"
    printf "█  %-65s █\n" "$1"
    echo "█                                                                   █"
    echo "█████████████████████████████████████████████████████████████████████"
    echo -e "${NC}"
}

banner "STARTING LINEAGE BUILD SCRIPT"

echo -e "${YELLOW}REMOVING OLD LOCAL MANIFESTS${NC}"
rm -rf .repo/local_manifests
rm -rf release-files

echo -e "${YELLOW}NUKING OLD STUFF${NC}"

echo -e "${YELLOW}INITIALIZING REPO WITH LINEAGE MANIFEST${NC}"
repo init -u https://github.com/LineageOS/android.git -b lineage-22.2 --git-lfs --depth=1

echo -e "${YELLOW}REMOVING OLD PREBUILTS AND HARDWARE REPOS${NC}"
rm -rf prebuilts/clang/host/linux-x86

echo -e "${YELLOW}SYNCING SOURCE CODE${NC}"
if [ -f /opt/crave/resync.sh ]; then
    /opt/crave/resync.sh
else
repo sync -c --no-clone-bundle --no-tags --optimized-fetch --prune --force-sync -j8
fi

echo -e "${YELLOW}CLONING DEVICE AND KERNEL REPOSITORIES${NC}"
rm -rf kernel/oneplus/sm8650
git clone --depth=1 https://github.com/OnePlus-12-Development/android_kernel_oneplus_sm8650 kernel/oneplus/sm8650
rm -rf device/oneplus/sm8650-common
git clone --depth=1 https://github.com/derpbygrep/android_device_oneplus_sm8650-common device/oneplus/sm8650-common
rm -rf hardware/oplus
git clone --depth=1 https://github.com/derpbygrep/android_hardware_oplus hardware/oplus
rm -rf kernel/oneplus/sm8650-modules
git clone --depth=1 https://github.com/derpbygrep/android_kernel_oneplus_sm8650-modules kernel/oneplus/sm8650-modules
rm -rf kernel/oneplus/sm8650-devicetrees
git clone --depth=1 https://github.com/derpbygrep/android_kernel_oneplus_sm8650-devicetrees kernel/oneplus/sm8650-devicetrees
rm -rf device/oneplus/lexus
git clone --depth=1 https://github.com/derpbygrep/device_oneplus_lexus device/oneplus/lexus
rm -rf vendor/oneplus
git clone --depth=1 https://gitea.com/grepfox/vendor_oneplus vendor/oneplus

git clone --depth=1 https://github.com//OnePlus-12-Development/android_kernel_qcom_sm8650-modules kernel/qcom/sm8650-modules
git clone --depth=1 https://github.com//OnePlus-12-Development/android_kernel_qcom_sm8650-devicetrees kernel/qcom/sm8650-devicetrees
git clone --depth=1 https://github.com/OnePlus-12-Development/android_kernel_qcom_sm8650 kernel/qcom/sm8650

echo -e "${YELLOW}SOURCING BUILD ENVIRONMENT${NC}"
source build/envsetup.sh
export TZ=Asia/Kolkata

echo -e "${YELLOW}SETTING BUILD TARGET AND OPTIONS${NC}"
m installclean
brunch lexus eng

echo -e "${YELLOW}COLLECTING BUILD OUTPUT FILES${NC}"
rm -rf lexus-files
mkdir -p lexus-files
cp -r out/target/product/lexus/lineage-22.2* lexus-files/ 2>/dev/null
cp -r out/target/product/lexus/{recovery.img,boot.img,init_boot.img,vendor_boot.img,vendor_dlkm.img,system_dlkm.img} lexus-files/ 2>/dev/null

echo -e "${YELLOW}CLEANING UP REPOS AFTER BUILD${NC}"
rm -rf prebuilts/clang/host/linux-x86

echo -e "${YELLOW}BUILD COMPLETE - CHECKING FOR ERRORS${NC}"
if [ -f out/error.log ]; then
    cat out/error.log
else
    echo -e "${GREEN}NO ERROR LOG FOUND - BUILD COMPLETED SUCCESSFULLY${NC}"
fi

echo -e "${YELLOW}OUTPUT DIRECTORY CONTENTS${NC}"
ls -lh out/target/product/lexus

banner "LINEAGE BUILD DONE"
