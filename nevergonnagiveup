echo "========================================"
echo "        STARTING YAAP BUILD SCRIPT      "
echo "========================================"

# ---------- INIT REPO ----------
echo "========== INITIALIZING YAAP MANIFEST =========="
repo init -u https://github.com/yaap/manifest -b sixteen --git-lfs --depth=1


# ---------- CLEANUP ----------
echo "========== CLEANING OLD MANIFESTS =========="
rm -rf .repo/local_manifests release-files device/xiaomi/vayu kernel/xiaomi/vayu vendor/xiaomi/vayu prebuilts/clang/host/linux-x86 hardware/xiaomi vendor/yaap

echo "========== CLONING LOCAL MANIFESTS =========="
git clone https://github.com/grepfox/local_manifest -b yaap .repo/local_manifests

# ---------- SYNC ----------
echo "========== SYNCING REPO =========="
if [ -f /opt/crave/resync.sh ]; then
    /opt/crave/resync.sh
else
    repo sync -j$(nproc --all) --force-sync --no-clone-bundle --no-tags
fi

# ---------- DisplayFeatures ----------
echo "========== UPDATING DisplayFeatures =========="
rm -rf packages/apps/DisplayFeatures
git clone https://github.com/yaap/packages_apps_DisplayFeatures packages/apps/DisplayFeatures

# ---------- Signing Keys ----------
echo "========== CLONING SIGNING KEYS =========="
rm -rf vendor/yaap/signing/keys
git clone https://$GH_TOKEN@github.com/grepfox/yaap_sign vendor/yaap/signing/keys

# ---------- BUILD ENV ----------
echo "========== SOURCING build/envsetup.sh =========="
source build/envsetup.sh
export TZ="Asia/Kolkata"

# ---------- BUILD CONFIG ----------
echo "========== CONFIGURING YAAP BUILD =========="
export YAAP_BUILDTYPE=Banshee
export TARGET_BUILD_GAPPS=true
lunch yaap_vayu-user

# ---------- CLEAN ----------
echo "========== INSTALLCLEAN =========="
m installclean

# ---------- BUILD ----------
echo "========== STARTING YAAP BUILD =========="
m yaap

# ---------- COPY OUTPUT ----------
echo "========== COPYING RELEASE FILES =========="
mkdir -p release-files
cp -r out/target/product/vayu/YAAP-16* release-files/
cp -r out/target/product/vayu/vayu.json release-files/

# ---------- POST-BUILD CLEANUP ----------
echo "========== POST-BUILD CLEANUP =========="
rm -rf prebuilts/clang/host/linux-x86 vendor/yaap/signing/keys vendor/yaap

# ---------- OUTPUT ----------
echo "========== BUILD OUTPUT =========="
ls out/target/product/vayu

echo "========== YAAP DEVICE JSON =========="
cat out/target/product/vayu/vayu.json

echo "========================================"
echo "        YAAP BUILD COMPLETED            "
echo "========================================"
