#!/bin/bash

# Define colors
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
NC='\033[0m' # No Color

function banner() {
    echo -e "${BLUE}"
    echo "█████████████████████████████████████████████████████████████████████"
    echo "█                                                                   █"
    printf "█  %-65s █\n" "$1"
    echo "█                                                                   █"
    echo "█████████████████████████████████████████████████████████████████████"
    echo -e "${NC}"
}

banner "STARTING LINEAGE BUILD SCRIPT"

echo -e "${YELLOW}REMOVING OLD LOCAL MANIFESTS${NC}"
rm -rf .repo/local_manifests
rm -rf lexus-files

echo -e "${YELLOW}NUKING OLD STUFF${NC}"

echo -e "${YELLOW}INITIALIZING REPO WITH LINEAGE MANIFEST${NC}"
repo init https://github.com/crdroidandroid/android.git -b 16.0 --git-lfs --depth=1

echo -e "${YELLOW}REMOVING OLD PREBUILTS AND HARDWARE REPOS${NC}"
rm -rf prebuilts/clang/host/linux-x86

echo -e "${YELLOW}SYNCING SOURCE CODE${NC}"
if [ -f /opt/crave/resync.sh ]; then
    /opt/crave/resync.sh
else
repo sync -c --no-clone-bundle --no-tags --optimized-fetch --prune --force-sync -j8
fi

echo -e "${YELLOW}CLONING DEVICE AND KERNEL REPOSITORIES${NC}"
rm -rf hardware/oplus
git clone --depth=1 https://github.com/LineageOS/android_hardware_oplus hardware/oplus -b lineage-23.0
rm -rf kernel/oneplus/sm8650
git clone --depth=1 https://github.com/Oneplus-Nord5-development/android_kernel_oneplus_sm8650 kernel/oneplus/sm8650 
rm -rf kernel/oneplus/sm8650-modules
git clone --depth=1 https://github.com/Oneplus-Nord5-development/android_kernel_oneplus_sm8650-modules kernel/oneplus/sm8650-modules -b lineage-23.0
rm -rf kernel/oneplus/sm8650-devicetrees
#git clone https://github.com/derpbygrep/kernel_oplus_sm8635-devicetrees kernel/oneplus/sm8650-devicetrees
rm -rf device/oneplus/lexus
git clone https://github.com/Oneplus-Nord5-development/android_device_oneplus_lexus device/oneplus/lexus -b staging
rm -rf device/oneplus/sm8650-common
git clone https://github.com/Oneplus-Nord5-development/android_device_oneplus_sm8650-common device/oneplus/sm8650-common -b staging
rm -rf vendor/oneplus/lexus
git clone https://github.com/Oneplus-Nord5-development/android_vendor_oneplus_lexus vendor/oneplus/lexus -b staging
rm -rf vendor/oneplus/sm8650-common
git clone https://github.com/Oneplus-Nord5-development/android_vendor_oneplus_sm8650-common vendor/oneplus/sm8650-common -b staging

#git clone --depth=1 https://github.com//OnePlus-12-Development/android_kernel_qcom_sm8650-modules kernel/qcom/sm8650-modules
#git clone --depth=1 https://github.com//OnePlus-12-Development/android_kernel_qcom_sm8650-devicetrees kernel/qcom/sm8650-devicetrees
#git clone --depth=1 https://github.com/Oneplus-Nord5-development/android_kernel_qcom_sm8650 kernel/qcom/sm8650 

#rm -rf device/oneplus/lexus-prebuilts
#git clone https://github.com/Oneplus-Nord5-development/android_device_oneplus_lexus-prebuilt device/oneplus/lexus-prebuilts

rm -rf device/oneplus/lexus-prebuilts
git clone https://github.com/Oneplus-Nord5-development/android_device_oneplus_lexus-kernel device/oneplus/lexus-prebuilts
rm -rf device/oneplus/lexus-prebuilts/kernel-headers
rm -rf device/oneplus/lexus-prebuilts/modules
rm -rf vendor/lineage-priv/keys
git clone https://$GH_TOKEN@github.com/grepfox/lexus-priv vendor/lineage-priv/keys -b lineage-23.0


echo -e "${YELLOW}SOURCING BUILD ENVIRONMENT${NC}"
source build/envsetup.sh
#rm -rf hardware/oplus/aidl/vibrator
rm -rf out/target/product/lexus/*.zip
rm -rf out/target/product/lexus/*.zip*

echo -e "${YELLOW}SETTING BUILD TARGET AND OPTIONS${NC}"
breakfast lexus
export TZ=Asia/Kolkata
export SKIP_ABI_CHECKS=true
m installclean
brunch lexus

echo -e "${YELLOW}COLLECTING BUILD OUTPUT FILES${NC}"
mkdir -p lexus-files
cp -r out/target/product/lexus/lineage-23.0* lexus-files/ 2>/dev/null
cp -r out/target/product/lexus/crDroidAndroid-16.0* lexus-files/ 2>/dev/null
cp -r out/target/product/lexus/{recovery.img,boot.img,dtbo.img,init_boot.img,vendor_boot.img} lexus-files/ 2>/dev/null

echo -e "${YELLOW}CLEANING UP REPOS AFTER BUILD${NC}"
rm -rf prebuilts/clang/host/linux-x86

echo -e "${YELLOW}BUILD COMPLETE - CHECKING FOR ERRORS${NC}"
if [ -f out/error.log ]; then
    cat out/error.log
else
    echo -e "${GREEN}NO ERROR LOG FOUND - BUILD COMPLETED SUCCESSFULLY${NC}"
fi

echo -e "${YELLOW}OUTPUT DIRECTORY CONTENTS${NC}"
ls -lh out/target/product/lexus
rm -rf vendor/lineage-priv/keys
banner "LINEAGE BUILD DONE"
