#!/bin/bash

echo "========================================"
echo "      STARTING YAAP BUILD SCRIPT        "
echo "========================================"

echo "========== REMOVING OLD LOCAL MANIFESTS =========="
rm -rf .repo/local_manifests
rm -rf release-files

echo "========== NUKING OLD STUFF =========="

echo "========== INITIALIZING REPO WITH YAAP MANIFEST =========="
repo init -u https://github.com/LineageOS/android.git -b lineage-22.2 --git-lfs


echo "========== REMOVING OLD PREBUILTS AND HARDWARE REPOS =========="
rm -rf prebuilts/clang/host/linux-x86

echo "========== RUNNING SYNC SCRIPT =========="

if [ -f /opt/crave/resync.sh ]; then
    /opt/crave/resync.sh
else
    repo sync -j8 --force-sync
fi

echo "========== SOURCING BUILD ENVIRONMENT =========="
source build/envsetup.sh
export TZ=Asia/Kolkata


echo "========== SETTING BUILD TARGET AND OPTIONS =========="
m installclean
brunch lexus eng

mkdir lexus-files
cp -r out/target/product/lexus/lineage-22.2* lexus-files
cp -r out/target/product/lexus/recovery.img lexus-files/
cp -r out/target/product/lexus/boot.img lexus-files/
cp -r out/target/product/lexus/init_boot.img lexus-files/
cp -r out/target/product/lexus/vendor_boot.img lexus-files/
cp -r out/target/product/lexus/vendor_dlkm.img lexus-files/
cp -r out/target/product/lexus/system_dlkm.img lexus-files/

echo "========== CLEANING UP REPOS AFTER BUILD =========="
rm -rf prebuilts/clang/host/linux-x86

echo "========== BUILD COMPLETE - CHECKING FOR ERRORS =========="
if [ -f out/error.log ]; then
    cat out/error.log
else
    echo "NO ERROR LOG FOUND - BUILD COMPLETED SUCCESSFULLY"
fi

echo "========== Sharing output dir ls =========="
ls out/target/product/vayu

echo "========== YAAP Build info =========="
cat out/target/product/vayu/vayu.json

echo "========================================"
echo "        YAAP BUILD DONE          "
echo "========================================"
